# Copy to backend/.env for local development. Never commit the real .env.
QLP_API_TITLE="Quantum Learning API"

# JSON array of exact frontend origins; [] disables cross-origin access.
# Example: ["http://localhost:5173", "http://127.0.0.1:5173"]
QLP_CORS_ORIGINS=[]

# AI Tutor: server-only, opt-in paid usage. Choose an API model available to your
# OpenAI project that supports Responses + structured outputs. No default model.
QLP_AI_ENABLED=false
QLP_AI_PROVIDER=openai
QLP_AI_MODEL=""
OPENAI_API_KEY=""
QLP_AI_MAX_OUTPUT_TOKENS=1600
QLP_AI_TIMEOUT_SECONDS=30
QLP_AI_MAX_CONCURRENCY=2
# Global per-process rolling limit, not a per-user quota or a spending cap.
QLP_AI_REQUESTS_PER_MINUTE=20
